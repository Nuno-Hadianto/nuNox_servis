{
  "name": "nunox_servis",
  "version": "1.0.0",
  "description": "",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "test": "set NODE_ENV=test&& jest",
    "test:e2e": "npm run build:all && set NODE_ENV=test&& playwright test",
    "start": "electron dist-electron/electron/main.js",
    "dev": "electron-reload dist-electron/electron/main.js",
    "dev:electron:watch": "tsc -p tsconfig.electron.json -w",
    "dev:vite": "vite",
    "dev:all": "concurrently \"npm run dev:vite\" \"npm run dev:electron:watch\" \"npm start\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:vite": "vite build",
    "build:all": "npm run build:electron && npm run build:vite",
    "build": "npm run build:all && electron-builder --win",
    "build:mac": "npm run build:all && electron-builder --mac",
    "build:linux": "npm run build:all && electron-builder --linux",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "lint": "eslint \"src/**/*.{js,ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,ts,vue}": [
      "npm run format",
      "npm run lint"
    ]
  },
  "build": {
    "appId": "com.nunox_servis.app",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "productName": "nuNox_servis",
    "icon": "public/img/icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist-electron/**/*",
      "dist_frontend/**/*",
      "public/**/*",
      "database/migrations/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuno-Hadianto/nuNox_servis.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Nuno-Hadianto/nuNox_servis/issues"
  },
  "homepage": "https://github.com/Nuno-Hadianto/nuNox_servis#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.10"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.42",
    "vue-router": "^4.5.0",
    "zod": "^4.4.3"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^../controllers/(.*)$": "<rootDir>/dist-electron/controllers/$1",
      "^../database/(.*)$": "<rootDir>/dist-electron/database/$1",
      "^../repositories/(.*)$": "<rootDir>/dist-electron/repositories/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "__tests__/e2e.spec.js",
      "__tests__/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.ts"
    ]
  }
}
